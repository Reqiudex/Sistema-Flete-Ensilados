# ==============================================================
# Variables de entorno – Backend Ensilados Santa Cruz
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# ==============================================================
PORT=3001
NODE_ENV=development

# Supabase (HU03, HU07, HU08, HU09). Si se omiten, el servidor funciona en modo memoria (solo demo/pruebas).
# Use la clave SERVICE_ROLE solo aquí (backend); jamás en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public           # en producción: tesis

# Google Maps Distance Matrix (HU04, HU05). Si se omite, se usa Haversine × 1,25.
GOOGLE_MAPS_API_KEY=

# JWT (HU06). Obligatorio en producción, mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Superadmin inicial (se crea al arrancar solo si no existen usuarios). Cambie la clave después de ingresar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tesis.cerice360.com,https://tesis.cherry.lat

# --- Pagos por QR (repositorio pasarela-pagos) ---
# Interruptor general: false despliega el sistema sin la pasarela (solo Transferencia y WhatsApp).
PAGOS_QR_HABILITADO=true
# Credenciales: dashboard https://pagos.cerice360.com → Apps → Nueva app. Solo backend; jamás en el frontend.
# Si falta cualquiera de las tres, el pago QR queda deshabilitado automáticamente.
PASARELA_API_URL=https://apipagos.cerice360.com   # (alias anterior: PASARELA_BASE_URL)
PASARELA_API_KEY=pk_ejemplo_reemplazar             # identifica a la app
PASARELA_SECRET=sk_ejemplo_reemplazar              # firma peticiones y verifica webhooks; se muestra una sola vez
PASARELA_EXPIRA_SEGUNDOS=600                       # vigencia de cada cobro (60 a 900 s)
PAGOS_RECONCILIAR_SEGUNDOS=60                      # respaldo: consulta cobros pendientes si no llega el webhook (0 = apagado)
# Webhook a registrar en la pasarela: https://<dominio>/api/pagos/webhook
PUBLIC_URL=https://tesis.cerice360.com             # return_url del checkout de pago (página de confirmación)
