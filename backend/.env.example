# ==============================================================
# Variables de entorno – Backend Ensilados Santa Cruz
# ==============================================================
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env real al repositorio (ver .gitignore)
# ==============================================================

# Puerto del servidor Express
PORT=3001

# ==============================================================
# Supabase – Base de datos PostgreSQL en la nube
# HU03, HU07, HU08, HU09
# Obtenga estos valores en: https://supabase.com → Proyecto → Settings → API
# ==============================================================
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Nota: Use SERVICE_ROLE_KEY (no anon key) en el backend para
#       operaciones con permisos de escritura completos.

# ==============================================================
# Google Maps Distance Matrix API
# HU04, HU05 – Cálculo de distancia de ruta terrestre
# Obtenga su clave en: https://console.cloud.google.com
# Active el servicio: "Distance Matrix API"
# ==============================================================
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ==============================================================
# JSON Web Token – Autenticación de administradores
# HU06 – Autenticación segura con JWT
# Use un string aleatorio y seguro (mínimo 32 caracteres)
# ==============================================================
JWT_SECRET=CAMBIE_ESTE_SECRETO_POR_UNO_SEGURO_DE_32_CARACTERES_MINIMO
JWT_EXPIRES_IN=8h

# ==============================================================
# Entorno de ejecución
# ==============================================================
NODE_ENV=development
