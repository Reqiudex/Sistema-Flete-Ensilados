# ==============================================================
# Variables de entorno – Backend Ensilados Santa Cruz
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# ==============================================================
PORT=3001
NODE_ENV=development

# Supabase (HU03, HU07, HU08, HU09). Si se omiten, el servidor funciona en modo memoria (solo demo/pruebas).
# Use la clave SERVICE_ROLE solo aquí (backend); jamás en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Distance Matrix (HU04, HU05). Si se omite, se usa Haversine × 1,25.
GOOGLE_MAPS_API_KEY=

# JWT (HU06). Obligatorio en producción, mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Superadmin inicial (se crea al arrancar solo si no existen usuarios). Cambie la clave después de ingresar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tesis.cherry.lat
