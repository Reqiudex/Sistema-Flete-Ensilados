# ==============================================================
# Variables para docker compose (copie este archivo como .env). NUNCA suba .env al repositorio.
# Para desarrollo sin Docker use backend/.env.example y frontend/.env.example.
# ==============================================================

# --- Backend ---
JWT_SECRET=                      # obligatorio, mínimo 32 caracteres aleatorios
JWT_EXPIRES_IN=8h
SUPABASE_URL=                    # opcional: sin Supabase la API funciona en modo memoria (solo demostración)
SUPABASE_SERVICE_ROLE_KEY=       # solo backend; jamás en el frontend
SUPABASE_SCHEMA=public           # en producción: tesis (esquema propio dentro del Supabase de Coolify)
GOOGLE_MAPS_API_KEY=             # Distance Matrix (servidor). Sin clave se usa Haversine × 1,25
ADMIN_EMAIL=                     # Superadmin inicial (se crea si no hay usuarios)
ADMIN_PASSWORD=                  # mínimo 8 caracteres; cámbiela tras el primer ingreso
CORS_ORIGINS=http://localhost:3000,https://tesis.cerice360.com,https://tesis.cherry.lat

# --- Pagos por QR (repositorio pasarela-pagos) ---
# Interruptor general: false despliega el sistema sin la pasarela (solo Transferencia y WhatsApp).
PAGOS_QR_HABILITADO=true
# Credenciales: dashboard https://pagos.cerice360.com → Apps → Nueva app. Solo backend; jamás en el frontend.
# Si falta cualquiera de las tres, el pago QR queda deshabilitado automáticamente.
PASARELA_API_URL=https://apipagos.cerice360.com   # (alias anterior: PASARELA_BASE_URL)
PASARELA_API_KEY=pk_ejemplo_reemplazar             # identifica a la app
PASARELA_SECRET=sk_ejemplo_reemplazar              # firma peticiones y verifica webhooks; se muestra una sola vez
PASARELA_EXPIRA_SEGUNDOS=600                       # vigencia de cada cobro (60 a 900 s)
PAGOS_RECONCILIAR_SEGUNDOS=60                      # respaldo: consulta cobros pendientes si no llega el webhook (0 = apagado)
# Webhook a registrar en la pasarela: https://<dominio>/api/pagos/webhook
PUBLIC_URL=https://tesis.cerice360.com             # return_url del checkout de pago (página de confirmación)

# --- Puertos (docker-compose.yml local / docker-compose.coolify.yml) ---
WEB_PORT=3000                    # en Coolify: 8091
API_PORT=3001                    # solo local (127.0.0.1)

# --- Frontend (se fijan al compilar) ---
VITE_API_URL=/api                # la API va por el proxy de Nginx en el mismo dominio
VITE_GOOGLE_MAPS_API_KEY=        # Maps JavaScript API (mapa interactivo); restringir por dominio
